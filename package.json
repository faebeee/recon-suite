{
  "name": "recon-suite",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:wifi-macos": "pnpm --filter @recon/api setup:wifi-macos",
    "compose:up": "podman compose up --build -d",
    "compose:down": "podman compose down",
    "compose:logs": "podman compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}

{
  "name": "recon-suite",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "turbo run dev",
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:macos-helper": "npm run setup:macos-helper -w @recon/api",
    "setup:wifi-macos": "npm run setup:macos-helper"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}

# Host ports used by podman compose
API_PORT=4000
WEB_PORT=8080
# Allow tools to target loopback/private networks (keep false when shared)
ALLOW_PRIVATE_TARGETS=false
LOCAL_TOOLS_ENABLED=false
# Kali container for nmap (Host Scan, Nmap Scan): engine socket for the API (see compose.yaml)
# CONTAINER_SOCKET=/var/run/docker.sock
# CONTAINER_SOCKET_GID=0
# KALI_API_USER=node
# Optional API keys
NVD_API_KEY=
SECURITYTRAILS_API_KEY=

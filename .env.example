# Host port of the reverse proxy (UI on /, API on /api); the only port compose publishes
APP_PORT=8090
# Interface the proxy listens on: 0.0.0.0 = every interface (LAN), 127.0.0.1 = this machine only.
# There is no login: everyone who can reach the port can run every tool.
BIND_ADDRESS=0.0.0.0
# Comma-separated URLs the app is opened with from other devices (CSRF allowlist), e.g.
# http://192.168.1.20:8090,http://raspberrypi.local:8090
PUBLIC_ORIGINS=
# Optional API keys
NVD_API_KEY=
SECURITYTRAILS_API_KEY=

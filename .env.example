# Host ports used by podman compose
API_PORT=4000
WEB_PORT=8080
# Allow tools to target loopback/private networks (keep false when shared)
ALLOW_PRIVATE_TARGETS=false
THROTTLE_LIMIT=60
LOCAL_TOOLS_ENABLED=false
# Login (required with containers: requests arrive through nginx, not from localhost).
# Generate a hash with: pnpm --filter @recon/api hash-password
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# Bearer token for scripts (min. 32 characters), e.g. openssl rand -hex 32
API_TOKEN=
# Set false only when the UI is served over plain HTTP on a host other than localhost
COOKIE_SECURE=true
# Kali container for nmap (Host Scan, Nmap Scan): engine socket for the API (see compose.yaml)
# CONTAINER_SOCKET=/var/run/docker.sock
# CONTAINER_SOCKET_GID=0
# KALI_API_USER=node
# Optional API keys
NVD_API_KEY=
SECURITYTRAILS_API_KEY=

# Build context: repository root (see compose.yaml)
FROM docker.io/library/node:26-alpine AS base
RUN npm install -g turbo@2.11.11
WORKDIR /app

# 1. Prune the monorepo down to @recon/api and its workspace deps
FROM base AS pruner
COPY . .
RUN turbo prune @recon/api --docker

# 2. Install deps (cached layer) and build. Production deps are pure JS (SQLite is node:sqlite),
#    so the output built on Alpine runs unchanged on the glibc-based Kali runtime below.
FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN npm ci
COPY --from=pruner /app/out/full/ .
RUN turbo run build --filter=@recon/api
# Drop dev dependencies; the runtime keeps the pruned workspace layout (@recon/shared is a
# workspace symlink in node_modules).
RUN npm prune --omit=dev

# 3. Runtime: Kali with the scanning tools, so the API runs nmap itself (no separate
#    Kali container, no container-engine socket).
FROM docker.io/kalilinux/kali-rolling:latest AS runner
# nmap: Host Scan, Network Scan, Nmap Scan. iproute2: default gateway for the system page (`ip -j route`).
# network-manager: nmcli for the WiFi tool; a no-op unless the host's NetworkManager D-Bus
# socket is mounted (see compose.yaml). libstdc++6: needed by the Node binary.
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    nmap \
    iproute2 \
    network-manager \
    ca-certificates \
    libstdc++6 \
  && rm -rf /var/lib/apt/lists/*
# Official glibc Node build (Kali's own nodejs package lags behind).
COPY --from=docker.io/library/node:26-slim /usr/local/bin/node /usr/local/bin/node
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/drizzle ./apps/api/drizzle
COPY apps/api/healthcheck.mjs /app/healthcheck.mjs
# SQLite database (engagements, history, notes, sessions); mounted as a volume by compose.
RUN mkdir -p /app/data
ENV DATABASE_PATH=/app/data/recon.db
# Runs as root inside the container so nmap can use raw sockets (ARP discovery, MAC/vendor);
# compose adds only NET_RAW/NET_ADMIN on top of the default capability set.
EXPOSE 4000
WORKDIR /app/apps/api
CMD ["node", "dist/main.js"]

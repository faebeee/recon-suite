# Build context: repository root (see compose.yaml)
FROM docker.io/library/node:26-alpine AS base
RUN npm install -g pnpm@11.1.0 turbo@2.11.11
WORKDIR /app

# 1. Prune the monorepo down to @recon/api and its workspace deps
FROM base AS pruner
COPY . .
RUN turbo prune @recon/api --docker

# 2. Install deps (cached layer) and build
FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN turbo run build --filter=@recon/api
RUN pnpm --filter=@recon/api deploy --prod --legacy /prod/api

# 3. Minimal runtime image
FROM docker.io/library/node:26-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
# nmcli client for the WiFi tool (R-01). It is a no-op unless the container is also granted
# access to the host's wireless adapter and NetworkManager D-Bus socket (see compose.yaml).
RUN apk add --no-cache networkmanager-cli
# docker CLI for the Kali container (compose.yaml sets WITH_DOCKER_CLI=true): Host Scan and
# Nmap Scan run as `docker exec recon-kali nmap ...`; this image has no scanning tools itself.
ARG WITH_DOCKER_CLI=false
RUN if [ "$WITH_DOCKER_CLI" = "true" ]; then apk add --no-cache docker-cli; fi
COPY --from=builder --chown=node:node /prod/api .
# SQLite database (engagements, history, notes, sessions); mounted as a volume by compose.
RUN mkdir -p /app/data && chown node:node /app/data
USER node
EXPOSE 4000
CMD ["node", "dist/main.js"]

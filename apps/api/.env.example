PORT=4000
ALLOW_PRIVATE_TARGETS=false
CORS_ORIGIN=http://localhost:5173
LOCAL_TOOLS_ENABLED=true
# SQLite file for engagements, history, notes and sessions
DATABASE_PATH=data/recon.db
# Without a password the API only accepts requests from this machine.
# ADMIN_PASSWORD=change-me-to-something-long
# ADMIN_PASSWORD_HASH=
# API_TOKEN=
COOKIE_SECURE=true
# NVD_API_KEY=
# SECURITYTRAILS_API_KEY=
# Run nmap (Host Scan, Nmap Scan) inside a Kali container (e.g. recon-kali from compose.yaml) via `exec`
# KALI_CONTAINER=recon-kali
# Recreate the container from this local image when it was removed (stopped ones are started)
# KALI_IMAGE=localhost/recon-suite/kali:latest
# CONTAINER_CLI=docker

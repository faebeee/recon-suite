# Build context: repository root (see compose.yaml)
FROM docker.io/library/node:26-alpine AS base
RUN npm install -g turbo@2.11.11
WORKDIR /app

# 1. Prune the monorepo down to @recon/web and its workspace deps
FROM base AS pruner
COPY . .
RUN turbo prune @recon/web --docker

# 2. Install deps (cached layer) and build static assets
FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN npm ci
COPY --from=pruner /app/out/full/ .
RUN turbo run build --filter=@recon/web

# 3. Serve with nginx (non-root, listens on 8090)
FROM docker.io/nginxinc/nginx-unprivileged:stable-alpine AS runner
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8090
